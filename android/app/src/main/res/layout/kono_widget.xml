<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/kono_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/kono_widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="@string/kono_widget_title" android:textStyle="bold" android:textSize="13sp" android:textColor="#E0607A" />
        <TextView android:id="@+id/kono_widget_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="11sp" android:textColor="#8A7680" />
    </LinearLayout>
    <TextView android:id="@+id/kono_widget_next1" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textSize="15sp" android:textStyle="bold" android:textColor="#4E3741" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/kono_widget_next2" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:textSize="13sp" android:textColor="#4E3741" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/kono_widget_next3" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="13sp" android:textColor="#4E3741" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/kono_widget_kono" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textSize="11sp" android:textColor="#8A7680" android:maxLines="2" android:ellipsize="end" />
</LinearLayout>
