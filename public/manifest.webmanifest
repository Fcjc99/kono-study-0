{
  "name": "KONO — Study Sanctuary",
  "short_name": "KONO",
  "description": "A calm study planner with assignments, colorful notes, and a growing pixel-art sanctuary.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#eef4ee",
  "theme_color": "#794d3d",
  "icons": [
    {
      "src": "/icons/kono-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/kono-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "shortcuts": [
    {
      "name": "Today",
      "short_name": "Today",
      "description": "Today's list and KONO",
      "url": "/?view=today",
      "icons": [
        {
          "src": "/icons/kono-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Add homework",
      "short_name": "Add",
      "description": "Add an assignment, exam or event",
      "url": "/?new=1",
      "icons": [
        {
          "src": "/icons/kono-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Planner",
      "short_name": "Planner",
      "description": "Your calendar",
      "url": "/?page=planner",
      "icons": [
        {
          "src": "/icons/kono-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
